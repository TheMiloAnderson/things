# Database (used by both app and MySQL container)
DBUSER=things
DBPASS=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# App secrets
SESSION_KEY=change-me-session-key
CSRF_KEY=change-me-csrf-key-at-least-32-chars-long

# Optional: set for production behind HTTPS proxy
# APP_BASE_URL=https://miloanderson.org
# CSRF_TRUSTED_ORIGINS=miloanderson.org
# CSRF_INSECURE=1

# Email (Resend)
# RESEND_API_KEY=
# MAIL_FROM_ADDR=Things <noreply@miloanderson.org>
# NEW_ACCOUNT_NOTIFICATION_EMAIL=
